  "fixed_sql": [
    {
      "name": "work_session_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"work_session_records\" (\"id\" TEXT NOT NULL, \"canonical_schema_version\" INTEGER NOT NULL, \"hotel_id\" TEXT NOT NULL, \"hotel_name\" TEXT NOT NULL, \"workflow\" TEXT NOT NULL, \"started_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"workday_locked\" INTEGER NOT NULL DEFAULT 0 CHECK (\"workday_locked\" IN (0, 1)), \"lock_updated_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "housekeeper_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"housekeeper_records\" (\"session_id\" TEXT NOT NULL REFERENCES work_session_records (id) ON DELETE CASCADE, \"id\" TEXT NOT NULL, \"display_name\" TEXT NOT NULL, \"palette_key\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"session_id\", \"id\"));"
        }
      ]
    },
    {
      "name": "work_assignment_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"work_assignment_records\" (\"session_id\" TEXT NOT NULL REFERENCES work_session_records (id) ON DELETE CASCADE, \"id\" TEXT NOT NULL, \"cart_number\" INTEGER NOT NULL, \"housekeeper_id\" TEXT NOT NULL, \"assigned_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"session_id\", \"id\"), UNIQUE (\"session_id\", \"cart_number\"));"
        }
      ]
    },
    {
      "name": "room_state_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"room_state_records\" (\"session_id\" TEXT NOT NULL REFERENCES work_session_records (id) ON DELETE CASCADE, \"room_number\" TEXT NOT NULL, \"assignment_id\" TEXT NOT NULL, \"phase\" TEXT NOT NULL, \"is_vip\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_vip\" IN (0, 1)), \"scheduled_for\" TEXT NULL, \"deleted_at\" TEXT NULL, \"selected_at\" TEXT NOT NULL, \"phase_updated_at\" TEXT NOT NULL, \"opened_at\" TEXT NULL, \"completed_at\" TEXT NULL, \"vip_updated_at\" TEXT NULL, \"scheduled_updated_at\" TEXT NULL, PRIMARY KEY (\"session_id\", \"room_number\"));"
        }
      ]
    },
    {
      "name": "room_note_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"room_note_records\" (\"session_id\" TEXT NOT NULL REFERENCES work_session_records (id) ON DELETE CASCADE, \"room_number\" TEXT NOT NULL, \"text_value\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"last_command_id\" TEXT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"session_id\", \"room_number\"));"
        }
      ]
    },
    {
      "name": "history_event_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"history_event_records\" (\"id\" TEXT NOT NULL, \"session_id\" TEXT NOT NULL REFERENCES work_session_records (id) ON DELETE CASCADE, \"command_id\" TEXT NOT NULL, \"event_type\" TEXT NOT NULL, \"event_version\" INTEGER NOT NULL DEFAULT 1, \"payload_json\" TEXT NOT NULL, \"happened_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "command_receipt_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"command_receipt_records\" (\"session_id\" TEXT NOT NULL REFERENCES work_session_records (id) ON DELETE CASCADE, \"command_id\" TEXT NOT NULL, \"command_version\" INTEGER NOT NULL DEFAULT 1, \"outcome\" TEXT NOT NULL, \"processed_at\" TEXT NOT NULL, PRIMARY KEY (\"session_id\", \"command_id\"));"
        }
      ]
    },
    {
      "name": "sync_outbox_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_outbox_records\" (\"event_id\" TEXT NOT NULL, \"session_id\" TEXT NOT NULL REFERENCES work_session_records (id) ON DELETE CASCADE, \"attempt_count\" INTEGER NOT NULL DEFAULT 0, \"next_attempt_at\" TEXT NULL, \"acknowledged_at\" TEXT NULL, PRIMARY KEY (\"event_id\"));"
        }
      ]
    },
    {
      "name": "sync_inbox_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_inbox_records\" (\"event_id\" TEXT NOT NULL, \"checksum\" TEXT NOT NULL, \"received_at\" TEXT NOT NULL, \"applied_at\" TEXT NULL, PRIMARY KEY (\"event_id\"));"
        }
      ]
    },
    {
      "name": "media_manifest_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"media_manifest_records\" (\"id\" TEXT NOT NULL, \"session_id\" TEXT NOT NULL REFERENCES work_session_records (id) ON DELETE CASCADE, \"assignment_id\" TEXT NULL, \"room_number\" TEXT NULL, \"kind\" TEXT NOT NULL, \"relative_path\" TEXT NOT NULL, \"checksum_sha256\" TEXT NOT NULL, \"origin_device_id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"mime_type\" TEXT NULL, \"duration_ms\" INTEGER NULL, \"transcript\" TEXT NULL, \"last_command_id\" TEXT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
